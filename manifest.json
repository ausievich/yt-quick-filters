{
  "manifest_version": 3,
  "name": "YouTrack Quick Filters",
  "version": "2.2.4",
  "description": "Add quick filter buttons to YouTrack Agile Boards. Create filters via a modal.",
  "icons": { "128": "icons/logo_128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-quick-filters@ausievich.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "webNavigation", "scripting"],
  "action": {
    "default_popup": "public/popup.html",
    "default_icon": {
      "128": "icons/logo_128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*/youtrack/*", "https://*/agiles/*", "https://*.youtrack.cloud/*"],
      "css": ["dist/content.css"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://*/youtrack/*", "https://*/agiles/*", "https://*.youtrack.cloud/*"],
  "background": {
    "service_worker": "dist/background.js",
    "scripts": ["dist/background.js"]
  },
  "minimum_chrome_version": "121"
}
