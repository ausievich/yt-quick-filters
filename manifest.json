{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "2.3.2",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": { "128": "icons/logo_128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-quick-filters@ausievich.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "public/popup.html",
    "default_icon": {
      "128": "icons/logo_128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/dashboard*",
        "https://*/issues*",
        "https://*/issue*",
        "https://*/agiles*",
        "https://*/projects*",
        "https://*/articles*",
        "https://*/reports*",
        "https://*/timesheets*",
        "https://*/gantt-charts*",
        "https://*/whiteboards*",
        "https://*/youtrack/*",
        "https://*.youtrack.cloud/*"
      ],
      "css": ["dist/content.css"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
