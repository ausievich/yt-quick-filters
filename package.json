{
  "name": "yt-quick-filters",
  "version": "2.2.6",
  "description": "Add quick filter buttons to YouTrack Agile Boards. Create filters via a modal.",
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "type-check": "tsc --noEmit",
    "package": "npm run build && npm run package:archive -- chrome && npm run package:archive -- firefox && npm run package:source",
    "package:chrome": "npm run build && npm run package:archive -- chrome",
    "package:firefox": "npm run build && npm run package:archive -- firefox && npm run package:source",
    "package:archive": "node scripts/package.mjs",
    "package:source": "node scripts/package.mjs source",
    "lint": "eslint \"src/**/*.{ts,tsx}\" webpack.config.js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.0.254",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "archiver": "^8.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "mini-css-extract-plugin": "^2.7.6",
    "prettier": "^3.9.8",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml,html}": "prettier --write"
  }
}
